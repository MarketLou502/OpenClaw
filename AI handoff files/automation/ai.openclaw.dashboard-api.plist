<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>ai.openclaw.dashboard-api</string>

    <key>Comment</key>
    <string>OpenClaw dashboard-api — backend for the Echo Show kiosk dashboard (/api/* routes, LAN-bound, port 18795)</string>

    <key>ProgramArguments</key>
    <array>
      <string>/opt/homebrew/opt/node@22/bin/node</string>
      <string>/Users/aaronmacmini/.openclaw/services/dashboard-api/server.js</string>
    </array>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/aaronmacmini/Library/Logs/openclaw/dashboard-api.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aaronmacmini/Library/Logs/openclaw/dashboard-api.log</string>
  </dict>
</plist>
