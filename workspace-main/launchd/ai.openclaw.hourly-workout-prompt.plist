<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>ai.openclaw.hourly-workout-prompt</string>

    <key>Comment</key>
    <string>OpenClaw native iMessage hourly micro-workout prompts — eight daily slots from 9 AM through 4 PM</string>

    <key>StartCalendarInterval</key>
    <array>
      <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
      <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
      <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
      <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
      <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
      <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
      <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
      <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>ProgramArguments</key>
    <array>
      <string>/opt/homebrew/opt/node@22/bin/node</string>
      <string>/Users/aaronmacmini/.openclaw/workspace-main/scripts/hourly-workout-prompt.js</string>
      <string>run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/aaronmacmini/.openclaw</string>

    <key>StandardOutPath</key>
    <string>/Users/aaronmacmini/Library/Logs/openclaw/hourly-workout-prompt.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aaronmacmini/Library/Logs/openclaw/hourly-workout-prompt.log</string>

    <key>RunAtLoad</key>
    <false/>
  </dict>
</plist>
